# ============================================================
#  PhishGuard AI — .gitignore
#  Keeps the repo clean, secure, and CI-ready
# ============================================================

# ------ Python ------
__pycache__/
*.py[cod]
*.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# ------ Virtual Environments ------
.venv/
venv/
ENV/
env/

# ------ Secrets & Credentials (NEVER commit these) ------
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# ------ Databases ------
*.sqlite
*.sqlite3
*.db
backend/phishguard.db

# ------ Node / Frontend ------
node_modules/
frontend/node_modules/
frontend/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------ Testing & Coverage ------
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# ------ OS & IDE ------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.orig
.snapshots/

# ------ Raw / Large Datasets (too big for GitHub without LFS) ------
dataset/
ml/data/*.csv
ml/data/*.zip
ml/data/*.tar.gz
ml/data/*.parquet

# Exception: keep provenance docs
!ml/data/PROVENANCE.md
!ml/data/.gitkeep
!ml/data/dataset.csv

# ------ ML Artifacts (tracked via Git LFS — see .gitattributes) ------
# These are tracked by LFS, not excluded
# *.joblib — handled in .gitattributes

# ------ Logs ------
*.log
logs/
ml/data/*.txt

