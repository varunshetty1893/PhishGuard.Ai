# PhishGuard AI - Environment Configuration Example

ENVIRONMENT=development
PORT=8000

# Database Configuration:
# For Neon PostgreSQL (Production & Academic Evaluation):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-pooler-xyz.region.aws.neon.tech/neondb?sslmode=require
# For Local/Offline Development (Default fallback):
DATABASE_URL=sqlite:///./phishguard.db

# Security & Cookies
SECRET_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
COOKIE_SECURE=false

# Optional API keys. The public feed/API sources work without these keys.
# PhishStats allows anonymous lookups with a 50-request/day per-IP limit.
# Register at https://phishstats.info/settings/api-keys for the higher free quota.
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHSTATS_API_KEY=
